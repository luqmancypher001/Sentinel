# Secret used to sign session JWTs and MFA challenge tokens.
# Required in production — the app refuses to start without it there.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional: dedicated key for encrypting TOTP secrets at rest.
# If unset, TOTP secrets are encrypted using JWT_SECRET instead — fine for a
# single-environment demo, but keep this consistent between the server and
# `npm run seed`, since mismatched keys make existing TOTP secrets undecryptable.
TOTP_ENC_KEY=

# Optional: enables real password-reset / security-alert emails via plain SMTP
# (e.g. Gmail: host smtp.gmail.com, port 587, an account "app password" as
# SMTP_PASS — not your normal Google password). If SMTP_HOST is unset, these
# emails are logged to the server console instead, which is enough to
# exercise both flows locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
